{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entity-manifest.org/schemas/entity-manifest.v1.schema.json",
  "title": "Entity Manifest v1.0",
  "type": "object",
  "required": ["spec", "entity"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": true
  },
  "properties": {
    "spec": {
      "type": "string",
      "const": "entity-manifest/1.0"
    },
    "entity": {
      "type": "object",
      "required": ["name", "type", "url"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" }
              ]
            }
          }
        ]
      }
    },
    "belongsTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 2048
      }
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "officialWebsite": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "registryEntries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          }
        }
      }
    }
  }
}
